digraph G {
  rankdir=BT; splines=polyline; nodesep=0.6; ranksep=0.9; compound=true;
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9];

JPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F2F2F2"><TR><TD>&laquo;Swing&raquo;</TD></TR><TR><TD><B>JPanel</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
JFrame [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F2F2F2"><TR><TD>&laquo;Swing&raquo;</TD></TR><TR><TD><B>JFrame</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
RefreshablePanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDEBF7"><TR><TD>&laquo;abstract&raquo;</TD></TR><TR><TD><B><I>RefreshablePanel</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT"># service : LibraryService</TD></TR><TR><TD ALIGN="LEFT"># onDataChanged : Runnable</TD></TR><HR/><TR><TD ALIGN="LEFT"># RefreshablePanel(service, onDataChanged)</TD></TR><TR><TD ALIGN="LEFT"><I>+ refresh() : void</I></TD></TR><TR><TD ALIGN="LEFT"># attempt(action : Action) : boolean</TD></TR><TR><TD ALIGN="LEFT"># showError(message : String) : void</TD></TR><TR><TD ALIGN="LEFT"># showInfo(message : String) : void</TD></TR><TR><TD ALIGN="LEFT"># confirm(message : String) : boolean</TD></TR><TR><TD ALIGN="LEFT"><U># readOnlyModel(columns : String...) : DefaultTableModel</U></TD></TR><TR><TD ALIGN="LEFT"><U># createTable(model) : JTable</U></TD></TR><TR><TD ALIGN="LEFT"><U># setColumnWidths(table : JTable, widths : int...) : void</U></TD></TR><TR><TD ALIGN="LEFT"><U># selectedValue(table : JTable, column : int) : String</U></TD></TR></TABLE>>];
ItemsPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0D9"><TR><TD><B>ItemsPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- model : DefaultTableModel</TD></TR><TR><TD ALIGN="LEFT">- table : JTable</TD></TR><TR><TD ALIGN="LEFT">- searchField : JTextField</TD></TR><TR><TD ALIGN="LEFT">- filterBox : JComboBox</TD></TR><TR><TD ALIGN="LEFT">- typeBox : JComboBox&lt;ItemType&gt;</TD></TR><TR><TD ALIGN="LEFT">- titleField, creatorField, yearField, extraField : JTextField</TD></TR><HR/><TR><TD ALIGN="LEFT">+ ItemsPanel(service, onDataChanged)</TD></TR><TR><TD ALIGN="LEFT">+ refresh() : void</TD></TR><TR><TD ALIGN="LEFT">- addItem() : void</TD></TR><TR><TD ALIGN="LEFT">- updateItem() : void</TD></TR><TR><TD ALIGN="LEFT">- deleteItem() : void</TD></TR><TR><TD ALIGN="LEFT">- loadSelectedIntoForm() : void</TD></TR><TR><TD ALIGN="LEFT">- clearForm() : void</TD></TR></TABLE>>];
MembersPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0D9"><TR><TD><B>MembersPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- model : DefaultTableModel</TD></TR><TR><TD ALIGN="LEFT">- table : JTable</TD></TR><TR><TD ALIGN="LEFT">- searchField : JTextField</TD></TR><TR><TD ALIGN="LEFT">- typeBox : JComboBox&lt;MemberType&gt;</TD></TR><TR><TD ALIGN="LEFT">- nameField, emailField : JTextField</TD></TR><HR/><TR><TD ALIGN="LEFT">+ MembersPanel(service, onDataChanged)</TD></TR><TR><TD ALIGN="LEFT">+ refresh() : void</TD></TR><TR><TD ALIGN="LEFT">- addMember() : void</TD></TR><TR><TD ALIGN="LEFT">- deleteMember() : void</TD></TR></TABLE>>];
CirculationPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0D9"><TR><TD><B>CirculationPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- itemBox : JComboBox&lt;LibraryItem&gt;</TD></TR><TR><TD ALIGN="LEFT">- memberBox : JComboBox&lt;Member&gt;</TD></TR><TR><TD ALIGN="LEFT">- borrowDateField : JTextField</TD></TR><TR><TD ALIGN="LEFT">- loanTable : JTable</TD></TR><TR><TD ALIGN="LEFT">- returnDateField : JTextField</TD></TR><HR/><TR><TD ALIGN="LEFT">+ CirculationPanel(service, onDataChanged)</TD></TR><TR><TD ALIGN="LEFT">+ refresh() : void</TD></TR><TR><TD ALIGN="LEFT">- borrow() : void</TD></TR><TR><TD ALIGN="LEFT">- returnSelected() : void</TD></TR></TABLE>>];
ReportsPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0D9"><TR><TD><B>ReportsPanel</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- totalItems, availableItems, members : JLabel</TD></TR><TR><TD ALIGN="LEFT">- activeLoans, overdueLoans, feesCollected : JLabel</TD></TR><TR><TD ALIGN="LEFT">- asOfField : JTextField</TD></TR><TR><TD ALIGN="LEFT">- overdueModel, historyModel : DefaultTableModel</TD></TR><HR/><TR><TD ALIGN="LEFT">+ ReportsPanel(service, onDataChanged)</TD></TR><TR><TD ALIGN="LEFT">+ refresh() : void</TD></TR></TABLE>>];
