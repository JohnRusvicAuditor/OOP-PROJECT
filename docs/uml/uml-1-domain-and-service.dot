digraph G {
  rankdir=BT; splines=polyline; nodesep=0.6; ranksep=0.9; compound=true;
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9];

Borrowable [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3CD"><TR><TD>&laquo;interface&raquo;</TD></TR><TR><TD><B>Borrowable</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ isAvailable() : boolean</TD></TR><TR><TD ALIGN="LEFT">+ checkOut() : void</TD></TR><TR><TD ALIGN="LEFT">+ checkIn() : void</TD></TR><TR><TD ALIGN="LEFT">+ getLoanPeriodDays() : int</TD></TR><TR><TD ALIGN="LEFT">+ calculateLateFee(daysLate : long) : double</TD></TR></TABLE>>];
LibraryItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDEBF7"><TR><TD>&laquo;abstract&raquo;</TD></TR><TR><TD><B><I>LibraryItem</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT">- title : String</TD></TR><TR><TD ALIGN="LEFT">- creator : String</TD></TR><TR><TD ALIGN="LEFT">- year : int</TD></TR><TR><TD ALIGN="LEFT">- available : boolean</TD></TR><HR/><TR><TD ALIGN="LEFT"># LibraryItem(id, title, creator, year)</TD></TR><TR><TD ALIGN="LEFT">+ getId() : String</TD></TR><TR><TD ALIGN="LEFT">+ getTitle() : String</TD></TR><TR><TD ALIGN="LEFT">+ getCreator() : String</TD></TR><TR><TD ALIGN="LEFT">+ getYear() : int</TD></TR><TR><TD ALIGN="LEFT">+ setTitle(title : String) : void</TD></TR><TR><TD ALIGN="LEFT">+ setCreator(creator : String) : void</TD></TR><TR><TD ALIGN="LEFT">+ setYear(year : int) : void</TD></TR><TR><TD ALIGN="LEFT">+ isAvailable() : boolean</TD></TR><TR><TD ALIGN="LEFT">+ checkOut() : void</TD></TR><TR><TD ALIGN="LEFT">+ checkIn() : void</TD></TR><TR><TD ALIGN="LEFT">+ calculateLateFee(daysLate : long) : double</TD></TR><TR><TD ALIGN="LEFT">+ getExtraLabel() : String</TD></TR><TR><TD ALIGN="LEFT">+ toString() : String</TD></TR><TR><TD ALIGN="LEFT"><I>+ getType() : ItemType</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getLateFeePerDay() : double</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getLoanPeriodDays() : int</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getExtraValue() : String</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ setExtraValue(value : String) : void</I></TD></TR></TABLE>>];
Book [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0D9"><TR><TD><B>Book</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- isbn : String</TD></TR><TR><TD ALIGN="LEFT">- LOAN_DAYS : int = 14</TD></TR><TR><TD ALIGN="LEFT">- FEE_PER_DAY : double = 5.0</TD></TR><HR/><TR><TD ALIGN="LEFT">+ Book(id, title, author, year)</TD></TR><TR><TD ALIGN="LEFT">+ getType() : ItemType</TD></TR><TR><TD ALIGN="LEFT">+ getLoanPeriodDays() : int</TD></TR><TR><TD ALIGN="LEFT">+ getLateFeePerDay() : double</TD></TR><TR><TD ALIGN="LEFT">+ getExtraValue() : String</TD></TR><TR><TD ALIGN="LEFT">+ setExtraValue(value : String) : void</TD></TR></TABLE>>];
Magazine [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0D9"><TR><TD><B>Magazine</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- issueNumber : int</TD></TR><TR><TD ALIGN="LEFT">- LOAN_DAYS : int = 7</TD></TR><TR><TD ALIGN="LEFT">- FEE_PER_DAY : double = 3.0</TD></TR><HR/><TR><TD ALIGN="LEFT">+ Magazine(id, title, publisher, year)</TD></TR><TR><TD ALIGN="LEFT">+ getType() : ItemType</TD></TR><TR><TD ALIGN="LEFT">+ getLoanPeriodDays() : int</TD></TR><TR><TD ALIGN="LEFT">+ getLateFeePerDay() : double</TD></TR><TR><TD ALIGN="LEFT">+ getExtraValue() : String</TD></TR><TR><TD ALIGN="LEFT">+ setExtraValue(value : String) : void</TD></TR></TABLE>>];
DVD [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0D9"><TR><TD><B>DVD</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- durationMinutes : int</TD></TR><TR><TD ALIGN="LEFT">- LOAN_DAYS : int = 3</TD></TR><TR><TD ALIGN="LEFT">- FEE_PER_DAY : double = 20.0</TD></TR><TR><TD ALIGN="LEFT">- MAX_FEE : double = 500.0</TD></TR><HR/><TR><TD ALIGN="LEFT">+ DVD(id, title, director, year)</TD></TR><TR><TD ALIGN="LEFT">+ getType() : ItemType</TD></TR><TR><TD ALIGN="LEFT">+ getLoanPeriodDays() : int</TD></TR><TR><TD ALIGN="LEFT">+ getLateFeePerDay() : double</TD></TR><TR><TD ALIGN="LEFT">+ calculateLateFee(daysLate : long) : double</TD></TR><TR><TD ALIGN="LEFT">+ getExtraValue() : String</TD></TR><TR><TD ALIGN="LEFT">+ setExtraValue(value : String) : void</TD></TR></TABLE>>];
Member [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDEBF7"><TR><TD>&laquo;abstract&raquo;</TD></TR><TR><TD><B><I>Member</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id : String</TD></TR><TR><TD ALIGN="LEFT">- name : String</TD></TR><TR><TD ALIGN="LEFT">- email : String</TD></TR><HR/><TR><TD ALIGN="LEFT"># Member(id, name, email)</TD></TR><TR><TD ALIGN="LEFT">+ getId() : String</TD></TR><TR><TD ALIGN="LEFT">+ getName() : String</TD></TR><TR><TD ALIGN="LEFT">+ getEmail() : String</TD></TR><TR><TD ALIGN="LEFT">+ setName(name : String) : void</TD></TR><TR><TD ALIGN="LEFT">+ setEmail(email : String) : void</TD></TR><TR><TD ALIGN="LEFT">+ applyDiscount(fee : double) : double</TD></TR><TR><TD ALIGN="LEFT">+ toString() : String</TD></TR><TR><TD ALIGN="LEFT"><I>+ getType() : MemberType</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getMaxLoans() : int</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getExtraLoanDays() : int</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getFeeDiscount() : double</I></TD></TR></TABLE>>];
Student [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0D9"><TR><TD><B>Student</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ Student(id, name, email)</TD></TR><TR><TD ALIGN="LEFT">+ getType() : MemberType</TD></TR><TR><TD ALIGN="LEFT">+ getMaxLoans() : int  (3)</TD></TR><TR><TD ALIGN="LEFT">+ getExtraLoanDays() : int  (0)</TD></TR><TR><TD ALIGN="LEFT">+ getFeeDiscount() : double  (0.0)</TD></TR></TABLE>>];
Faculty [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F0D9"><TR><TD><B>Faculty</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ Faculty(id, name, email)</TD></TR><TR><TD ALIGN="LEFT">+ getType() : MemberType</TD></TR><TR><TD ALIGN="LEFT">+ getMaxLoans() : int  (10)</TD></TR><TR><TD ALIGN="LEFT">+ getExtraLoanDays() : int  (7)</TD></TR><TR><TD ALIGN="LEFT">+ getFeeDiscount() : double  (0.5)</TD></TR></TABLE>>];
Loan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD><B>Loan</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id : int</TD></TR><TR><TD ALIGN="LEFT">- item : LibraryItem</TD></TR><TR><TD ALIGN="LEFT">- member : Member</TD></TR><TR><TD ALIGN="LEFT">- borrowDate : LocalDate</TD></TR><TR><TD ALIGN="LEFT">- dueDate : LocalDate</TD></TR><TR><TD ALIGN="LEFT">- returnDate : LocalDate</TD></TR><TR><TD ALIGN="LEFT">- feeCharged : double</TD></TR><HR/><TR><TD ALIGN="LEFT">+ Loan(id, item, member, borrowDate)</TD></TR><TR><TD ALIGN="LEFT">+ getId() : int</TD></TR><TR><TD ALIGN="LEFT">+ getItem() : LibraryItem</TD></TR><TR><TD ALIGN="LEFT">+ getMember() : Member</TD></TR><TR><TD ALIGN="LEFT">+ getBorrowDate() : LocalDate</TD></TR><TR><TD ALIGN="LEFT">+ getDueDate() : LocalDate</TD></TR><TR><TD ALIGN="LEFT">+ getReturnDate() : LocalDate</TD></TR><TR><TD ALIGN="LEFT">+ getFeeCharged() : double</TD></TR><TR><TD ALIGN="LEFT">+ isReturned() : boolean</TD></TR><TR><TD ALIGN="LEFT">+ getDaysLate(asOf : LocalDate) : long</TD></TR><TR><TD ALIGN="LEFT">+ isOverdue(asOf : LocalDate) : boolean</TD></TR><TR><TD ALIGN="LEFT">+ markReturned(date : LocalDate) : void</TD></TR></TABLE>>];
ItemType [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EDEDED"><TR><TD>&laquo;enumeration&raquo;</TD></TR><TR><TD><B>ItemType</B></TD></TR><HR/><TR><TD ALIGN="LEFT">BOOK</TD></TR><TR><TD ALIGN="LEFT">MAGAZINE</TD></TR><TR><TD ALIGN="LEFT">DVD</TD></TR><HR/><TR><TD ALIGN="LEFT">+ getLabel() : String</TD></TR><TR><TD ALIGN="LEFT">+ getIdPrefix() : String</TD></TR><TR><TD ALIGN="LEFT">+ getExtraLabel() : String</TD></TR></TABLE>>];
MemberType [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EDEDED"><TR><TD>&laquo;enumeration&raquo;</TD></TR><TR><TD><B>MemberType</B></TD></TR><HR/><TR><TD ALIGN="LEFT">STUDENT</TD></TR><TR><TD ALIGN="LEFT">FACULTY</TD></TR><HR/><TR><TD ALIGN="LEFT">+ getLabel() : String</TD></TR><TR><TD ALIGN="LEFT">+ getIdPrefix() : String</TD></TR></TABLE>>];
LibraryService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FCE4D6"><TR><TD><B>LibraryService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- items : Map&lt;String, LibraryItem&gt;</TD></TR><TR><TD ALIGN="LEFT">- members : Map&lt;String, Member&gt;</TD></TR><TR><TD ALIGN="LEFT">- loans : List&lt;Loan&gt;</TD></TR><TR><TD ALIGN="LEFT">- idCounters : Map&lt;String, Integer&gt;</TD></TR><TR><TD ALIGN="LEFT">- loanCounter : int</TD></TR><TR><TD ALIGN="LEFT">- totalFeesCollected : double</TD></TR><HR/><TR><TD ALIGN="LEFT">+ addItem(type, title, creator, year, extra) : LibraryItem</TD></TR><TR><TD ALIGN="LEFT">+ findItem(id : String) : Optional&lt;LibraryItem&gt;</TD></TR><TR><TD ALIGN="LEFT">+ getItem(id : String) : LibraryItem</TD></TR><TR><TD ALIGN="LEFT">+ updateItem(id, title, creator, year, extra) : void</TD></TR><TR><TD ALIGN="LEFT">+ removeItem(id : String) : void</TD></TR><TR><TD ALIGN="LEFT">+ searchItems(query : String, type : ItemType) : List&lt;LibraryItem&gt;</TD></TR><TR><TD ALIGN="LEFT">+ getAvailableItems() : List&lt;LibraryItem&gt;</TD></TR><TR><TD ALIGN="LEFT">+ addMember(type : MemberType, name, email) : Member</TD></TR><TR><TD ALIGN="LEFT">+ findMember(id : String) : Optional&lt;Member&gt;</TD></TR><TR><TD ALIGN="LEFT">+ getMember(id : String) : Member</TD></TR><TR><TD ALIGN="LEFT">+ removeMember(id : String) : void</TD></TR><TR><TD ALIGN="LEFT">+ searchMembers(query : String) : List&lt;Member&gt;</TD></TR><TR><TD ALIGN="LEFT">+ borrowItem(itemId, memberId : String, borrowDate : LocalDate) : Loan</TD></TR><TR><TD ALIGN="LEFT">+ returnItem(loanId : int, returnDate : LocalDate) : Loan</TD></TR><TR><TD ALIGN="LEFT">+ countActiveLoans(member : Member) : int</TD></TR><TR><TD ALIGN="LEFT">+ getActiveLoansOf(member : Member) : List&lt;Loan&gt;</TD></TR><TR><TD ALIGN="LEFT">+ getActiveLoans() : List&lt;Loan&gt;</TD></TR><TR><TD ALIGN="LEFT">+ getOverdueLoans(asOf : LocalDate) : List&lt;Loan&gt;</TD></TR><TR><TD ALIGN="LEFT">+ getAllLoans() : List&lt;Loan&gt;</TD></TR><TR><TD ALIGN="LEFT">+ getTotalItems() : int</TD></TR><TR><TD ALIGN="LEFT">+ getAvailableItemCount() : int</TD></TR><TR><TD ALIGN="LEFT">+ getTotalMembers() : int</TD></TR><TR><TD ALIGN="LEFT">+ getTotalLoansEver() : int</TD></TR><TR><TD ALIGN="LEFT">+ getTotalFeesCollected() : double</TD></TR></TABLE>>];
LibraryException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F8CBAD"><TR><TD><B>LibraryException</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ LibraryException(message : String)</TD></TR></TABLE>>];
Exception [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F2F2F2"><TR><TD><B>Exception</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
Validator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EDEDED"><TR><TD>&laquo;utility&raquo;</TD></TR><TR><TD><B>Validator</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT"><U>+ requireText(field, value : String, maxLength : int) : String</U></TD></TR><TR><TD ALIGN="LEFT"><U>+ requireName(field, value : String) : String</U></TD></TR><TR><TD ALIGN="LEFT"><U>+ requireEmail(value : String) : String</U></TD></TR><TR><TD ALIGN="LEFT"><U>+ requireRange(field : String, value, min, max : int) : void</U></TD></TR><TR><TD ALIGN="LEFT"><U>+ parseInt(field, value : String, min, max : int) : int</U></TD></TR><TR><TD ALIGN="LEFT"><U>+ parseDate(field, value : String) : LocalDate</U></TD></TR></TABLE>>];
LibraryItem -> Borrowable [arrowhead=empty, style=dashed];
Book -> LibraryItem [arrowhead=empty, style=solid];
Magazine -> LibraryItem [arrowhead=empty, style=solid];
DVD -> LibraryItem [arrowhead=empty, style=solid];
Student -> Member [arrowhead=empty, style=solid];
Faculty -> Member [arrowhead=empty, style=solid];
LibraryException -> Exception [arrowhead=empty, style=solid];
LibraryItem -> ItemType [arrowhead=open, style=solid, label="getType()"];
Member -> MemberType [arrowhead=open, style=solid, label="getType()"];
Loan -> LibraryItem [arrowhead=open, style=solid, label="item", taillabel="*", headlabel="1"];
Loan -> Member [arrowhead=open, style=solid, label="member", taillabel="*", headlabel="1"];
LibraryService -> Loan [dir=back, arrowtail=diamond, label="loans", headlabel="0..*"];
LibraryService -> LibraryItem [dir=back, arrowtail=diamond, label="items", headlabel="0..*"];
LibraryService -> Member [dir=back, arrowtail=diamond, label="members", headlabel="0..*"];
LibraryService -> LibraryException [arrowhead=open, style=dashed, label="throws"];
LibraryService -> Validator [arrowhead=open, style=dashed, label="uses"];
}